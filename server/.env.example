# ---- 服务 ----
PORT=3000
NODE_ENV=development

# ---- MySQL 8.0 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=改成你的密码
DB_NAME=xianxia
DB_CONNECTION_LIMIT=10

# ---- 鉴权 ----
# 务必换成一串足够长的随机字符串，不要用这个示例值
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- 数值 ----
# 离线收益上限（小时），超出部分按 20% 折算
SETTLE_MAX_HOURS=12
# 轮询结算的最小落库间隔（秒），避免每 5 秒写一次库
SETTLE_MIN_PERSIST_SECONDS=60
# 流水落库的最小间隔（秒）
SETTLE_MIN_LOG_SECONDS=300
# 挂机收益中转化为修为的比例
SETTLE_EXP_RATE=0.6
