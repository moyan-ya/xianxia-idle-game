{
  "name": "xianxia-server",
  "version": "0.1.0",
  "private": true,
  "description": "仙侠放置游戏后端 · Node 16 + Express + MySQL 8",
  "main": "app.js",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
